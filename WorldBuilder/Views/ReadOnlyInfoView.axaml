<UserControl
    x:Class="WorldBuilder.Views.ReadOnlyInfoView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WorldBuilder.ViewModels"
    d:DesignHeight="300"
    d:DesignWidth="500"
    x:CompileBindings="True"
    x:DataType="vm:ReadOnlyInfoViewModel"
    mc:Ignorable="d">
    <Grid>
        <Border
            MaxWidth="560"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#120c22"
            BorderBrush="#3b2a5a"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="12">
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Text="{Binding Title}" />
                <TextBlock
                    Foreground="#cbbfe0"
                    Text="{Binding Message}"
                    TextWrapping="Wrap" />
                <Button
                    Classes="accent"
                    Command="{Binding ActionCommand}"
                    Content="{Binding ActionText}"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding HasAction}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
