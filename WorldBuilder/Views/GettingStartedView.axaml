<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WorldBuilder.ViewModels"
             x:Class="WorldBuilder.Views.GettingStartedView"
             x:CompileBindings="True"
             x:DataType="vm:MainViewModel"
             Width="560">
    <Border Classes="acme-card" Padding="22">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#d4a843"
                           LetterSpacing="2"
                           Text="ACME WORLDBUILDER" />
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#efe7ff"
                           Text="Build worlds without guessing" />
                <TextBlock Classes="hint"
                           Text="This editor has two kinds of work: scenes you walk around in, and tables the game reads for spells, skills, and creatures." />
            </StackPanel>

            <StackPanel Spacing="10">
                <Border Classes="acme-stat">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="step-index" Text="1. Outdoor world" />
                        <TextBlock Classes="hint" Text="Open World. Fly the map, pick Height or Terrain, then make a small change and Undo if you do not like it." />
                    </StackPanel>
                </Border>
                <Border Classes="acme-stat">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="step-index" Text="2. Dungeons" />
                        <TextBlock Classes="hint" Text="Open Dungeon, start empty or from a template, click a doorway, then click a room piece. Check dungeon reports problems." />
                    </StackPanel>
                </Border>
                <Border Classes="acme-stat">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="step-index" Text="3. Game data" />
                        <TextBlock Classes="hint" Text="Spells, weenies, and monsters live in the Content tabs. Search, copy something that already works, then Save. File → Export DATs sends it to the client." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <CheckBox Content="Don't show this again"
                      IsChecked="{Binding HideGettingStartedNextTime}" />

            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Classes="ghost"
                        Content="Keyboard shortcuts"
                        Command="{Binding OpenKeyboardShortcutsCommand}"
                        Margin="8,0,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary"
                            Content="Start in World"
                            Command="{Binding StartInWorldCommand}" />
                    <Button Classes="ghost"
                            Content="Start in Dungeon"
                            Command="{Binding StartInDungeonCommand}" />
                    <Button Classes="ghost"
                            Content="Got it"
                            Command="{Binding CloseGettingStartedCommand}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
