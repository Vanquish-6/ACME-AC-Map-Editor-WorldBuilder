<UserControl
    x:Class="WorldBuilder.Editors.Landscape.Views.BrushSubToolView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WorldBuilder.Editors.Landscape.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:BrushSubToolViewModel"
    mc:Ignorable="d">
    <StackPanel Spacing="10">
        <TextBlock
            FontSize="14"
            FontWeight="SemiBold"
            Text="Brush Settings" />

        <!--  Brush Radius  -->
        <StackPanel Spacing="5">
            <TextBlock Text="Brush Radius" />
            <Grid ColumnDefinitions="*,80">
                <Slider
                    Grid.Column="0"
                    IsSnapToTickEnabled="True"
                    Maximum="200"
                    Minimum="0.5"
                    TickFrequency="0.5"
                    Value="{Binding BrushRadius}" />
                <NumericUpDown
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Minimum="0.5"
                    Maximum="200"
                    Increment="0.5"
                    FormatString="F1"
                    ShowButtonSpinner="False"
                    Value="{Binding BrushRadius}"
                    FontSize="11"
                    Padding="4,2" />
            </Grid>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Falloff" />
            <Grid ColumnDefinitions="*,80">
                <Slider Grid.Column="0" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding BrushFalloff}" />
                <NumericUpDown Grid.Column="1" Margin="6,0,0,0" Minimum="0" Maximum="1" Increment="0.05" FormatString="F2" ShowButtonSpinner="False" Value="{Binding BrushFalloff}" FontSize="11" Padding="4,2" />
            </Grid>
            <TextBlock FontSize="10" Opacity="0.7" Text="Soft edge. 0 is a hard disk. [ and ] resize the brush." TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="Texture" FontSize="12" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding AvailableTerrainTypes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="2" Padding="6,3" FontSize="10"
                            Content="{Binding}"
                            Command="{Binding $parent[UserControl].((vm:BrushSubToolViewModel)DataContext).SelectTerrainTypeCommand}"
                            CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
            FontSize="11"
            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
            Text="Pick a swatch here or from the Textures panel. Green footprint shows the brush on the ground."
            TextWrapping="Wrap"
            Opacity="0.7" />
    </StackPanel>
</UserControl>
