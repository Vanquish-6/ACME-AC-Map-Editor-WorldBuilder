<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WorldBuilder.Editors.Dungeon"
             x:Class="WorldBuilder.Editors.Dungeon.Views.DungeonProblemsView"
             x:DataType="vm:DungeonProblemsViewModel">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="10,8,10,4">
            <Button DockPanel.Dock="Right" Classes="ghost" Content="Recheck"
                    Command="{Binding RecheckCommand}" FontSize="11" Padding="8,2" />
            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#c0b0d8"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                 Background="Transparent" FontSize="11">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DungeonProblemItem">
                    <Border Padding="8,6" Margin="0,1" CornerRadius="4" Background="#16102a">
                        <StackPanel Spacing="2">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Location}"
                                           FontSize="10" Foreground="#8a7a9e" />
                                <TextBlock Text="{Binding SeverityLabel}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{Binding SeverityBrush}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Message}" Foreground="#e8e0f4" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Explanation}" Classes="muted" TextWrapping="Wrap"
                                       IsVisible="{Binding HasExplanation}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
