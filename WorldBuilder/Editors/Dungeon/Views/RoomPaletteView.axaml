<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WorldBuilder.Editors.Dungeon"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="600"
             x:Class="WorldBuilder.Editors.Dungeon.Views.RoomPaletteView"
             x:DataType="vm:RoomPaletteViewModel">

    <UserControl.Styles>
        <!-- Badge style for small info pills -->
        <Style Selector="Border.info-badge">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Margin" Value="0,0,3,0" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="6,6,6,2"
                IsVisible="{Binding !IsStarterKitMode}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding SearchText}"
                         Watermark="Search pieces..."
                         FontSize="11" />
                <ToggleButton Grid.Column="1"
                              IsChecked="{Binding ShowFavoritePrefabsMode}"
                              ToolTip.Tip="Show only favorite pieces"
                              Padding="4,2" FontSize="11" Margin="6,0,0,0"
                              Background="Transparent" BorderThickness="0">
                    <Panel>
                        <TextBlock Text="&#x2605;" FontSize="14" Foreground="#c8a832"
                                   IsVisible="{Binding ShowFavoritePrefabsMode}" />
                        <TextBlock Text="&#x2606;" FontSize="14" Foreground="#5a4a6e"
                                   IsVisible="{Binding !ShowFavoritePrefabsMode}" />
                    </Panel>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- Category filter -->
        <Border DockPanel.Dock="Top" Padding="6,2"
                IsVisible="{Binding !ShowFavoritePrefabsMode}">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding CatalogCategories}"
                              SelectedItem="{Binding CatalogCategory}"
                              FontSize="11" HorizontalAlignment="Stretch" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowCompatibleOnly}"
                              Content="Fits"
                              FontSize="10" Foreground="#6ec07a"
                              ToolTip.Tip="Only show pieces that connect to open doorways"
                              Margin="6,0,0,0" VerticalAlignment="Center"
                              IsVisible="{Binding !IsStarterKitMode}" />
                </Grid>
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#d4a843"
                           IsVisible="{Binding IsStarterKitMode}"
                           Text="{Binding StarterKitHint}"
                           TextWrapping="Wrap" />
                <Button Classes="ghost" Content="Show all kit rooms"
                        Command="{Binding ShowFullKitCommand}"
                        IsVisible="{Binding ShowFullKitButton}"
                        FontSize="11" HorizontalAlignment="Left" Padding="6,2" />
            </StackPanel>
        </Border>

        <!-- Status -->
        <Border DockPanel.Dock="Bottom"
                Padding="6,4"
                BorderBrush="#2a1d42"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="10"
                       Foreground="#5a4a6e" />
        </Border>

        <!-- Building knowledge base indicator -->
        <Border DockPanel.Dock="Top" Padding="12,16"
                Background="#1a0e30" IsVisible="{Binding IsBuildingKnowledgeBase}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="Building Piece Catalog..."
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#4dbdbd" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding BuildingMessage}"
                           FontSize="11" Foreground="#6a8a8a"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Height="4"
                             Foreground="#4dbdbd" Background="#2a1d42" />
            </StackPanel>
        </Border>

        <!-- Piece List (wrapping grid when panel is wide) -->
        <ScrollViewer IsVisible="{Binding !IsBuildingKnowledgeBase}">
            <ItemsControl ItemsSource="{Binding PrefabEntries}" FontSize="11">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PrefabListEntry">
                    <Border Margin="2,2" Padding="6,6" CornerRadius="4"
                            Background="#120c22"
                            BorderBrush="{Binding CompatibleBrush}"
                            BorderThickness="1"
                            PointerEntered="PrefabItem_PointerEntered"
                            PointerExited="PrefabItem_PointerExited"
                            PointerPressed="PrefabItem_PointerPressed"
                            PointerMoved="PrefabItem_PointerMoved"
                            PointerReleased="PrefabItem_PointerReleased"
                            HorizontalAlignment="Stretch"
                            MinWidth="200">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">

                            <!-- Thumbnail -->
                            <Panel Grid.Column="0" Grid.RowSpan="2" Width="64" Height="64" Margin="0,0,8,0">
                                <Border Background="#FF0E0A16" CornerRadius="4"
                                        IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />
                                <Image Width="64" Height="64" Source="{Binding Thumbnail}" Stretch="Uniform"
                                       IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Panel>

                            <TextBlock Grid.Column="1" Grid.Row="0"
                                       Text="{Binding DisplayName}"
                                       Foreground="#c0e0e0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2" />

                            <TextBlock Grid.Column="1" Grid.Row="1"
                                       Text="{Binding DoorListText}"
                                       Foreground="#8aba8a"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
